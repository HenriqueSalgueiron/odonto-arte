{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["cypress", "node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["**/*.ts", "../cypress.config.ts"]
}
