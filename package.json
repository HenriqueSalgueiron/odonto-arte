{
  "name": "odontoarte",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "openapi": "pnpm --filter @odontoarte/api openapi:generate",
    "kubb": "kubb generate --config kubb.config.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:open": "tsx scripts/e2e.ts --open"
  },
  "devDependencies": {
    "@eslint/js": "^9.25",
    "@kubb/cli": "^4.37.2",
    "@kubb/core": "^4.37.2",
    "@kubb/plugin-client": "^4.37.2",
    "@kubb/plugin-oas": "^4.37.2",
    "@kubb/plugin-react-query": "^4.37.2",
    "@kubb/plugin-ts": "^4.37.2",
    "@kubb/plugin-zod": "^4.37.2",
    "@types/pg": "^8.20.0",
    "eslint": "^9.25",
    "pg": "^8.21.0",
    "start-server-and-test": "^3.0.8",
    "tsx": "^4.21.0",
    "turbo": "^2.5",
    "typescript": "^5.8",
    "typescript-eslint": "^8.31"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/client",
      "@prisma/engines",
      "cypress",
      "esbuild",
      "prisma"
    ]
  }
}
